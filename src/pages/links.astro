---
import Layout from "../layouts/main.astro";

const publications = [
  {
    label: "Substack · Newsletter (English)",
    name: "The Principal Stack",
    description: "Deep technical writing on AI-native engineering and architecture. The decisions, trade-offs, and patterns that matter at scale. No hype, no tutorials.",
    url: "https://principalstack.substack.com/",
    handle: "principalstack.substack.com"
  },
  {
    label: "Substack · Newsletter (German)",
    name: "Stack und Kalkül",
    description: "Sovereign AI for DACH decision-makers: modular, exit-capable, EU-compliant. Weekly depth on Cognitive Debt and the architecture decisions that hold up in front of a board and an auditor. Written in German.",
    url: "https://pascalgiessler.substack.com/",
    handle: "pascalgiessler.substack.com"
  },
  {
    label: "Medium · Articles",
    name: "Medium",
    description: "Articles on generative AI strategy, cloud architecture patterns, and technology leadership for senior engineers and CTOs.",
    url: "https://medium.com/@pmgiessler",
    handle: "medium.com/@pmgiessler"
  },
  {
    label: "LinkedIn · Thought Leadership",
    name: "LinkedIn",
    description: "Regular insights on AI-native engineering, generative AI strategy, and the technical decisions that separate good architecture from great architecture.",
    url: "https://www.linkedin.com/in/pgiessler/",
    handle: "linkedin.com/in/pgiessler"
  }
];
---

<Layout
  title="Writing & Publications"
  description="Dr. Pascal Giessler writes on AI-native engineering, cloud architecture, and technical leadership on Substack, Medium, and LinkedIn."
  keywords="Pascal Giessler, Writing, Substack, Medium, LinkedIn, AI, Cloud Architecture"
>
  <main class="relative z-10 max-w-3xl mx-auto px-6 pt-28 pb-24 lg:pt-36">

    <div class="mb-14">
      <p class="section-label mb-4 fade-up delay-1">Writing &amp; Publications</p>
      <h1
        class="fade-up delay-2"
        style="font-family: 'Cormorant', Georgia, serif; font-size: clamp(2.4rem, 5vw, 3.8rem); font-weight: 300; line-height: 1.1; letter-spacing: -0.02em; color: var(--text);"
      >
        Where I <em style="font-style: italic; color: var(--gold-light);">publish</em>
      </h1>
    </div>

    <div class="fade-up delay-3 grid grid-cols-1 gap-4">
      {publications.map((pub) => (
        <a
          href={pub.url}
          target="_blank"
          class="writing-card"
        >
          <p class="writing-card-label">{pub.label}</p>
          <h3 class="writing-card-title">{pub.name}</h3>
          <p class="writing-card-desc">{pub.description}</p>
          <p
            class="mt-4"
            style="font-family: 'JetBrains Mono', monospace; font-size: 0.62rem; letter-spacing: 0.1em; color: var(--gold-dim);"
          >
            {pub.handle} ↗
          </p>
        </a>
      ))}
    </div>

  </main>
</Layout>
