---
import { getCollection, render, type CollectionEntry } from "astro:content";
import PostLayout from "../../layouts/post.astro";
import { sortedPosts, slugOf } from "../../lib/posts.mjs";

interface Props {
  entry: CollectionEntry<"post">;
  prev: { title: string; href: string } | null;
  next: { title: string; href: string } | null;
}

// English essays only. German essays are served from /de/post/<slug>/ so their
// URL matches the language they are written in (see src/lib/posts.mjs).
export async function getStaticPaths() {
  const all = await getCollection("post");
  const sorted = sortedPosts(all).filter((p) => (p.data.lang ?? "en") === "en");

  return sorted.map((entry, index) => ({
    params: { slug: slugOf(entry) },
    props: {
      entry,
      prev: index < sorted.length - 1
        ? { title: sorted[index + 1].data.title, href: sorted[index + 1]._path }
        : null,
      next: index > 0
        ? { title: sorted[index - 1].data.title, href: sorted[index - 1]._path }
        : null,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const wordCount = (entry.body ?? "").split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.round(wordCount / 200));
---

<PostLayout frontmatter={{ ...entry.data, readingTime }} prev={prev} next={next}>
  <Content />
</PostLayout>
