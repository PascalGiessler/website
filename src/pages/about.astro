---
import experiences from "../collections/experiences.json";
import AboutExperience from "../components/about-experience.astro";
import FaqSection from "../components/faq-section.astro";
import Layout from "../layouts/main.astro";
import { canonicalFaq, faqSchema } from "../data/entity";

const faq = canonicalFaq.en;
---

<Layout
  title="About"
  description="Dr. Pascal Giessler is the architect against Cognitive Debt. He builds sovereign AI for regulated and future-critical DACH organisations: auditable, exit-capable, resilient. AI Principal & Tech Lead, PhD (KIT Karlsruhe), based in Freiburg."
  keywords="Pascal Giessler, About, Cognitive Debt, Sovereign AI, Agentic Engineering, AI Principal, PhD, KIT, MIT, Haufe Akademie, CTO, DACH"
  jsonLd={faqSchema(faq, "en")}
>
  <main class="relative z-10 max-w-3xl mx-auto px-6 pt-28 pb-24 lg:pt-36">

    <!-- ── PAGE HEADING ──────────────────────────────── -->
    <div class="mb-16">
      <p class="section-label mb-4 fade-up delay-1">About</p>
      <h1
        class="fade-up delay-2 mb-6"
        style="font-family: 'Cormorant', Georgia, serif; font-size: clamp(2.8rem, 6vw, 4.5rem); font-weight: 300; line-height: 1.05; letter-spacing: -0.02em; color: var(--text);"
      >
        Dr. Pascal <em style="font-style: italic; color: var(--gold-light);">Giessler</em>
      </h1>
      <span class="gold-rule fade-up delay-3"></span>
    </div>

    <!-- ── PHOTO ─────────────────────────────────────── -->
    <div class="fade-up delay-3 mb-14 flex justify-start">
      <div class="relative" style="width: 240px; flex-shrink: 0;">
        <!-- Corner brackets -->
        <div class="absolute -top-2.5 -left-2.5 w-6 h-6 pointer-events-none" style="border-top: 2px solid var(--gold); border-left: 2px solid var(--gold);"></div>
        <div class="absolute -top-2.5 -right-2.5 w-6 h-6 pointer-events-none" style="border-top: 2px solid var(--gold); border-right: 2px solid var(--gold);"></div>
        <div class="absolute -bottom-2.5 -left-2.5 w-6 h-6 pointer-events-none" style="border-bottom: 2px solid var(--gold); border-left: 2px solid var(--gold);"></div>
        <div class="absolute -bottom-2.5 -right-2.5 w-6 h-6 pointer-events-none" style="border-bottom: 2px solid var(--gold); border-right: 2px solid var(--gold);"></div>
        <img
          src="/assets/images/photo_pascal_branded.png"
          alt="Dr. Pascal Giessler"
          style="display: block; width: 240px; height: 240px; object-fit: cover; object-position: center 10%; box-shadow: 0 0 0 1px var(--border-gold);"
        />
      </div>
    </div>

    <!-- ── BIO ───────────────────────────────────────── -->
    <div class="fade-up delay-4 mb-14">
      <h2
        class="mb-4"
        style="font-family: 'Outfit', system-ui, sans-serif; font-size: 1.1rem; font-weight: 600; color: var(--text); letter-spacing: 0.01em;"
      >
        Short Bio
      </h2>
      <div
        class="space-y-4 text-base leading-relaxed"
        style="color: var(--text-2); max-width: 62ch;"
      >
        <p>
          I work at the intersection of applied AI engineering and technical
          leadership. At Haufe Akademie, I lead strategic initiatives at the
          frontier of AI: high-risk, research-intensive work where the path
          is unclear and the stakes are real. As a speaker and strategic advisor, I help management
          boards of companies across sizes understand their AI opportunity,
          define their north star, and turn vision into executable strategy.
          Father, husband, and lifelong learner based in Freiburg.
        </p>
        <p>
          I founded Fabricks, building Smart Factory components that optimized
          warehouse logistics, supply chains, and internal digitalization for
          manufacturing clients. I also spent nine years at a DACH engineering
          services consultancy, growing from Head of Development through Head
          of R&amp;D to CTO across more than a dozen client industries. That
          trajectory: building
          products, scaling teams, making bet-the-company architecture
          decisions. That is what I write about. Not theory. The real
          decisions, with the scar tissue to prove it.
        </p>
        <p>
          Alongside industry work, I hold a PhD from KIT Karlsruhe and serve as
          an external lecturer at its WASA research group. I write
          <a
            href="https://principalstack.substack.com/"
            target="_blank"
            style="color: var(--gold-light); text-decoration: underline; text-underline-offset: 3px;"
          >Principal Stack</a>,
          a weekly newsletter for engineers who think at system scale, and I'm
          building ContentNexus, an open-source intelligence aggregation system
          for knowledge workers.
        </p>
      </div>
    </div>

    <!-- ── CREDENTIALS ───────────────────────────────── -->
    <div class="fade-up delay-5 mb-16">
      <h2
        class="mb-5"
        style="font-family: 'Outfit', system-ui, sans-serif; font-size: 1.1rem; font-weight: 600; color: var(--text); letter-spacing: 0.01em;"
      >
        Credentials
      </h2>
      <div class="flex flex-wrap gap-2">
        <span class="credential">PhD · KIT Karlsruhe</span>
        <span class="credential">MIT · Innovation Management</span>
        <span class="credential">MBA · PowerMBA</span>
        <span class="credential">Azure Solutions Architect Expert</span>
        <span class="credential">AWS Expert</span>
        <span class="credential">Founder · Fabricks</span>
        <span class="credential">Former CTO · DACH consultancy</span>
        <span class="credential">Technical Leadership Masterclass</span>
        <span class="credential">Industry Fellow · 42 Wolfsburg</span>
      </div>
    </div>

    <!-- ── SPEAKING ───────────────────────────────────── -->
    <div class="fade-up delay-5 mb-16">
      <h2
        class="mb-5"
        style="font-family: 'Outfit', system-ui, sans-serif; font-size: 1.1rem; font-weight: 600; color: var(--text); letter-spacing: 0.01em;"
      >
        Speaking &amp; Advisory
      </h2>
      <p
        class="mb-6 text-base leading-relaxed"
        style="color: var(--text-2); max-width: 62ch;"
      >
        I speak at conferences, leadership offsites, and executive briefings on AI strategy,
        engineering leadership, and the organizational change that comes with adopting AI at scale.
        Topics I cover regularly:
      </p>
      <ul
        class="mb-6 space-y-2 text-sm leading-relaxed"
        style="color: var(--text-2);"
      >
        <li style="display: flex; gap: 0.75rem;"><span style="color: var(--gold-dim); flex-shrink: 0;">→</span>From AI experimentation to production confidence: building an AI-native engineering culture</li>
        <li style="display: flex; gap: 0.75rem;"><span style="color: var(--gold-dim); flex-shrink: 0;">→</span>The AI Principal role: what changes when AI becomes a first-class concern in engineering</li>
        <li style="display: flex; gap: 0.75rem;"><span style="color: var(--gold-dim); flex-shrink: 0;">→</span>Making the $37B question: how to evaluate, scope, and justify enterprise AI investment</li>
        <li style="display: flex; gap: 0.75rem;"><span style="color: var(--gold-dim); flex-shrink: 0;">→</span>Technical leadership at the frontier: decisions under uncertainty in applied AI projects</li>
      </ul>
      <a
        href="mailto:info@pascal-giessler.de"
        class="btn-outline"
        style="display: inline-flex;"
      >
        Invite me to speak
      </a>
    </div>

    <!-- ── EXPERIENCE ────────────────────────────────── -->
    <div class="fade-up delay-5 mb-16">
      <h2
        class="mb-8"
        style="font-family: 'Outfit', system-ui, sans-serif; font-size: 1.1rem; font-weight: 600; color: var(--text); letter-spacing: 0.01em;"
      >
        Experience
      </h2>

      <div class="pl-2">
        {experiences.map((exp) => (
          <AboutExperience
            dates={exp.dates}
            role={exp.en.role}
            company={exp.company}
            description={exp.en.description}
          />
        ))}
      </div>
    </div>

    <!-- ── CONNECT ───────────────────────────────────── -->
    <div
      class="fade-up delay-6 pt-10 border-t"
      style="border-color: var(--border);"
    >
      <h2
        class="mb-4"
        style="font-family: 'Outfit', system-ui, sans-serif; font-size: 1.1rem; font-weight: 600; color: var(--text); letter-spacing: 0.01em;"
      >
        Let's Connect
      </h2>
      <p
        class="text-base leading-relaxed mb-6"
        style="color: var(--text-2); max-width: 55ch;"
      >
        Subscribe to
        <a
          href="https://principalstack.substack.com/"
          target="_blank"
          style="color: var(--gold-light); text-decoration: underline; text-underline-offset: 3px;"
        >Principal Stack</a>
        for weekly insights on AI engineering and technical leadership. Follow
        longer conversations on
        <a
          href="https://www.linkedin.com/in/pgiessler/"
          target="_blank"
          style="color: var(--gold-light); text-decoration: underline; text-underline-offset: 3px;"
        >LinkedIn</a>,
        read long-form on
        <a
          href="https://medium.com/@pmgiessler"
          target="_blank"
          style="color: var(--gold-light); text-decoration: underline; text-underline-offset: 3px;"
        >Medium</a>,
        or reach me by
        <a
          href="mailto:info@pascal-giessler.de"
          style="color: var(--gold-light); text-decoration: underline; text-underline-offset: 3px;"
        >email</a>.
      </p>

      <a
        href="https://www.linkedin.com/in/pgiessler/"
        target="_blank"
        class="btn-gold"
      >
        Connect on LinkedIn
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
        </svg>
      </a>
    </div>

<section class="fade-up delay-5">
      <div class="max-w-5xl mx-auto px-6 py-20">
        <h2 class="section-label mb-10">Areas of work</h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 mb-8">

          <div class="pillar">
            <p class="pillar-num">01</p>
            <h3 class="pillar-title">AI-Native Engineering</h3>
            <p class="pillar-body">
              Context engineering, evals, LLM routing, local inference, and
              RAG architecture. Building systems that treat AI as a
              first-class concern, not an integration bolted on after the fact.
            </p>
            <div class="pillar-tags">
              <span class="pillar-tag">LLMs</span>
              <span class="pillar-tag">RAG</span>
              <span class="pillar-tag">evals</span>
              <span class="pillar-tag">context engineering</span>
              <span class="pillar-tag">local inference</span>
            </div>
            <p class="pillar-proof">High-risk, frontier AI initiatives at Haufe Akademie</p>
          </div>

          <div class="pillar">
            <p class="pillar-num">02</p>
            <h3 class="pillar-title">Cloud Architecture</h3>
            <p class="pillar-body">
              Cloud-native platforms on AWS and Azure. Distributed systems,
              DevSecOps, infrastructure-as-code, and SRE practices built
              for enterprise scale and long-term operability.
            </p>
            <div class="pillar-tags">
              <span class="pillar-tag">Azure</span>
              <span class="pillar-tag">AWS</span>
              <span class="pillar-tag">Kubernetes</span>
              <span class="pillar-tag">Terraform</span>
              <span class="pillar-tag">DevSecOps</span>
            </div>
            <p class="pillar-proof">Azure Solutions Architect Expert · AWS · 10+ enterprise deployments</p>
          </div>

          <div class="pillar">
            <p class="pillar-num">03</p>
            <h3 class="pillar-title">Technical Leadership</h3>
            <p class="pillar-body">
              AI strategy, governance, ROI framing, and the architecture
              decisions that separate production-grade systems from
              well-funded prototypes. For leaders who think at system scale.
            </p>
            <div class="pillar-tags">
              <span class="pillar-tag">AI strategy</span>
              <span class="pillar-tag">governance</span>
              <span class="pillar-tag">ROI frameworks</span>
              <span class="pillar-tag">team scaling</span>
            </div>
            <p class="pillar-proof">9 years leading engineering teams as CTO</p>
          </div>

          <div class="pillar">
            <p class="pillar-num">04</p>
            <h3 class="pillar-title">Research &amp; Publications</h3>
            <p class="pillar-body">
              Doctoral research at KIT Karlsruhe's WASA group on software
              architecture. Weekly writing on AI engineering for
              practitioners who want depth, not summaries.
            </p>
            <div class="pillar-tags">
              <span class="pillar-tag">software architecture</span>
              <span class="pillar-tag">WASA · KIT</span>
              <span class="pillar-tag">Principal Stack</span>
              <span class="pillar-tag">Medium</span>
            </div>
            <p class="pillar-proof">8+ years doctoral research · weekly newsletter</p>
          </div>

          <div class="pillar">
            <p class="pillar-num">05</p>
            <h3 class="pillar-title">Strategic Advisory</h3>
            <p class="pillar-body">
              Advising management boards across company sizes on AI
              opportunity, north star definition, and the gap between
              vision and executable strategy. I understand the business,
              the process, and the domain: not just the technology.
            </p>
            <div class="pillar-tags">
              <span class="pillar-tag">board advisory</span>
              <span class="pillar-tag">AI strategy</span>
              <span class="pillar-tag">north star</span>
              <span class="pillar-tag">transformation</span>
              <span class="pillar-tag">keynote speaker</span>
            </div>
            <p class="pillar-proof">Advisor to management boards · enterprise &amp; mid-market</p>
          </div>

          <div class="pillar">
            <p class="pillar-num">06</p>
            <h3 class="pillar-title">Founder &amp; Company Building</h3>
            <p class="pillar-body">
              Founded and led Fabricks, building Smart Factory components
              for warehouse logistics and supply chain digitalization.
              Grew from engineer to CTO at a DACH engineering services
              consultancy over nine years across more than a dozen industries.
            </p>
            <div class="pillar-tags">
              <span class="pillar-tag">0→1</span>
              <span class="pillar-tag">Smart Factory</span>
              <span class="pillar-tag">supply chain</span>
              <span class="pillar-tag">ventures</span>
              <span class="pillar-tag">scale</span>
            </div>
            <p class="pillar-proof">Founder &amp; CEO · Fabricks · 9 yrs CTO at DACH consultancy</p>
          </div>

          <div class="pillar">
            <p class="pillar-num">07</p>
            <h3 class="pillar-title">Venture Building</h3>
            <p class="pillar-body">
              Taking ideas from zero to product and spinning them out as
              independent businesses. I help companies identify internal
              opportunities, validate concepts, build the product, and
              structure the venture for independence, or acquisition.
            </p>
            <div class="pillar-tags">
              <span class="pillar-tag">idea to product</span>
              <span class="pillar-tag">spin-out</span>
              <span class="pillar-tag">validation</span>
              <span class="pillar-tag">MVP</span>
              <span class="pillar-tag">venture structure</span>
            </div>
            <p class="pillar-proof">Ideas to reality · structured for independence</p>
          </div>

          <div class="pillar">
            <p class="pillar-num">08</p>
            <h3 class="pillar-title">Keynote Speaking</h3>
            <p class="pillar-body">
              Speaking at conferences, corporate events, and leadership
              offsites on AI strategy and engineering. Making complex
              architectural decisions legible to both technical teams
              and executive audiences.
            </p>
            <div class="pillar-tags">
              <span class="pillar-tag">keynote</span>
              <span class="pillar-tag">AI strategy</span>
              <span class="pillar-tag">workshops</span>
              <span class="pillar-tag">corporate events</span>
            </div>
            <p class="pillar-proof">Speaker · Industry Fellow · 42 Wolfsburg</p>
          </div>

        </div>

    </section>

    <FaqSection items={faq} heading="Frequently asked" />

  </main>
</Layout>
