---
import PostsLoop from "../components/posts-loop.astro";
import Layout from "../layouts/main.astro";
---

<Layout
  title="Writing"
  description="Essays by Dr. Pascal Giessler on Cognitive Debt, sovereign AI, and agentic engineering. Written for engineering leaders in regulated and future-critical DACH organisations."
  keywords="Pascal Giessler, essays, Cognitive Debt, sovereign AI, Agentic Engineering, AI-Native Transformation, EU AI Act, DACH"
  image="/assets/images/og/posts.png"
>
  <main class="relative z-10 max-w-3xl mx-auto px-6 pt-28 pb-24 lg:pt-36">

    <div class="mb-12">
      <p class="section-label mb-4 fade-up delay-1">Writing</p>
      <h1
        class="fade-up delay-2"
        style="font-family: 'Cormorant', Georgia, serif; font-size: clamp(2.4rem, 5vw, 3.8rem); font-weight: 300; line-height: 1.1; letter-spacing: -0.02em; color: var(--text);"
      >
        Articles &amp; <em style="font-style: italic; color: var(--gold-light);">essays</em>
      </h1>
    </div>

    <div class="fade-up delay-3">
      <PostsLoop />
    </div>

  </main>
</Layout>
