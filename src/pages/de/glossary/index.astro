---
import Layout from "../../../layouts/main.astro";
import GlossaryBody from "../../../components/glossary-body.astro";
import { glossaryJsonLd } from "../../../data/glossary";

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = glossaryJsonLd("de", pageUrl);
---

<Layout
  title="Glossar: Agentic AI & Harness"
  description="Ein dry und präzises Glossar agentischer KI: Harness, Agenten, Tool Use, MCP, RAG, GraphRAG, Guardrails, Evals und die Souveränitätsbegriffe (Cognitive Debt, souveräne KI, Provenienz), die darüber entscheiden, wem das System gehört. Von Dr. Pascal Giessler."
  keywords="Agentic AI Glossar, Harness, KI Agent, Tool Use, MCP, RAG, GraphRAG, Guardrails, Eval, Context Engineering, Cognitive Debt, souveräne KI, Provenienz, Vendor Lock-in, EU AI Act, Pascal Giessler, DACH"
  jsonLd={jsonLd}
>
  <GlossaryBody lang="de" />
</Layout>
