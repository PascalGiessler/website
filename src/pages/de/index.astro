---
import Layout from "../../layouts/main.astro";
import HeroParticles from "../../components/hero-particles.astro";
---

<Layout title="Dr. Pascal Giessler | KI Principal & Cloud Architekt">
  <main class="relative z-10">

    <!-- ── HERO ─────────────────────────────────────── -->
    <section class="relative max-w-5xl mx-auto px-6 pt-28 pb-24 lg:pt-36 lg:pb-32">
      <HeroParticles />
      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-20 items-center">

        <!-- Left: Text -->
        <div>
          <p class="hero-label fade-up delay-1 mb-6">
            KI Principal &nbsp;·&nbsp; Speaker &nbsp;·&nbsp; Gründer &nbsp;·&nbsp; Promovierter Informatiker &nbsp;·&nbsp; Freiburg
          </p>

          <h1 class="hero-name fade-up delay-2 mb-7">
            Dr. Pascal<br /><em>Giessler</em>
          </h1>

          <span class="gold-rule fade-up delay-3 mb-7"></span>

          <p
            class="fade-up delay-3 mb-8 text-base leading-relaxed"
            style="color: var(--text-2); max-width: 48ch;"
          >
            Ich begleite CTOs, Engineering-Leitungen und Visionäre dabei, von
            KI-Experimenten zu produktiver Reife zu kommen. Principal bei der
            Haufe Akademie, externer Dozent am KIT Karlsruhe, Gründer, Speaker
            und strategischer Berater. Ich schreibe für Entscheider, die
            festlegen, was gebaut wird, nicht was nur als Buzzword durchläuft.
          </p>

          <div class="fade-up delay-4 flex flex-wrap gap-3 mb-10">
            <a
              href="https://principalstack.substack.com/"
              target="_blank"
              class="btn-gold"
            >
              Principal Stack lesen
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
            </a>
            <a href="/de/about" class="btn-outline">
              Über mich
            </a>
          </div>

          <div class="fade-up delay-5 flex flex-wrap gap-2">
            <span class="credential">PhD · KIT</span>
            <span class="credential">MIT · Innovation Management</span>
            <span class="credential">MBA · PowerMBA</span>
            <span class="credential">Azure &amp; AWS Expert</span>
            <span class="credential">Speaker</span>
            <span class="credential">Gründer · Fabricks</span>
            <span class="credential">CTO · SYNDIKAT7</span>
          </div>
        </div>

        <!-- Right: Photo -->
        <div class="fade-up delay-3 flex justify-center items-center lg:justify-center">
          <div class="relative w-full max-w-[200px] lg:max-w-sm">
            <div class="absolute -top-3 -left-3 w-7 h-7 pointer-events-none" style="border-top: 2px solid var(--gold); border-left: 2px solid var(--gold);"></div>
            <div class="absolute -top-3 -right-3 w-7 h-7 pointer-events-none" style="border-top: 2px solid var(--gold); border-right: 2px solid var(--gold);"></div>
            <div class="absolute -bottom-3 -left-3 w-7 h-7 pointer-events-none" style="border-bottom: 2px solid var(--gold); border-left: 2px solid var(--gold);"></div>
            <div class="absolute -bottom-3 -right-3 w-7 h-7 pointer-events-none" style="border-bottom: 2px solid var(--gold); border-right: 2px solid var(--gold);"></div>
            <img
              src="/assets/images/photo_pascal_branded.png"
              alt="Dr. Pascal Giessler"
              loading="eager"
              decoding="auto"
              class="relative z-10 w-full"
              style="box-shadow: 0 0 0 1px var(--border-gold); display: block;"
            />
            <div
              class="absolute bottom-0 left-0 right-0 h-28 z-20"
              style="background: linear-gradient(to top, var(--bg) 10%, transparent);"
            ></div>
          </div>
        </div>

      </div>
    </section>

    <!-- ── EXPERTISE ──────────────────────────────────── -->
    <section
      class="border-t border-b"
      style="border-color: var(--border);"
    >
      <div class="max-w-5xl mx-auto px-6 py-20">
        <h2 class="section-label mb-10">Worauf ich arbeite</h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 mb-8">

          <div class="pillar">
            <p class="pillar-num">01</p>
            <h3 class="pillar-title">KI-Native Engineering</h3>
            <p class="pillar-body">
              Context Engineering, Evals, LLM-Routing, lokale Inferenz und
              RAG-Architektur. Systeme, die KI als Kernanliegen behandeln,
              nicht als nachträgliche Integration.
            </p>
            <div class="pillar-tags">
              <span class="pillar-tag">LLMs</span>
              <span class="pillar-tag">RAG</span>
              <span class="pillar-tag">Evals</span>
              <span class="pillar-tag">Context Engineering</span>
              <span class="pillar-tag">Lokale Inferenz</span>
            </div>
            <p class="pillar-proof">Hochrisiko-, Frontier-KI-Initiativen bei der Haufe Akademie</p>
          </div>

          <div class="pillar">
            <p class="pillar-num">02</p>
            <h3 class="pillar-title">Cloud-Architektur</h3>
            <p class="pillar-body">
              Cloud-native Plattformen auf AWS und Azure. Verteilte Systeme,
              DevSecOps, Infrastructure-as-Code und SRE-Praktiken, gebaut
              für Unternehmensskalierung und langfristige Betreibbarkeit.
            </p>
            <div class="pillar-tags">
              <span class="pillar-tag">Azure</span>
              <span class="pillar-tag">AWS</span>
              <span class="pillar-tag">Kubernetes</span>
              <span class="pillar-tag">Terraform</span>
              <span class="pillar-tag">DevSecOps</span>
            </div>
            <p class="pillar-proof">Azure Solutions Architect Expert · AWS · 10+ Enterprise-Deployments</p>
          </div>

          <div class="pillar">
            <p class="pillar-num">03</p>
            <h3 class="pillar-title">Technical Leadership</h3>
            <p class="pillar-body">
              KI-Strategie, Governance, ROI-Frameworks und die
              Architekturentscheidungen, die produktionsreife Systeme von
              gut finanzierten Prototypen unterscheiden. Für Führungskräfte,
              die im Systemmaßstab denken.
            </p>
            <div class="pillar-tags">
              <span class="pillar-tag">KI-Strategie</span>
              <span class="pillar-tag">Governance</span>
              <span class="pillar-tag">ROI-Frameworks</span>
              <span class="pillar-tag">Team-Skalierung</span>
            </div>
            <p class="pillar-proof">9 Jahre Engineering-Führung als CTO</p>
          </div>

          <div class="pillar">
            <p class="pillar-num">04</p>
            <h3 class="pillar-title">Forschung &amp; Publikationen</h3>
            <p class="pillar-body">
              Promotion am KIT Karlsruhe in der WASA-Gruppe zu
              Softwarearchitektur. Wöchentliche Beiträge zur
              KI-Engineering-Praxis für Leser, die Tiefe wollen, keine
              Zusammenfassungen.
            </p>
            <div class="pillar-tags">
              <span class="pillar-tag">Softwarearchitektur</span>
              <span class="pillar-tag">WASA · KIT</span>
              <span class="pillar-tag">Principal Stack</span>
              <span class="pillar-tag">Medium</span>
            </div>
            <p class="pillar-proof">8+ Jahre Promotion · wöchentlicher Newsletter</p>
          </div>

          <div class="pillar">
            <p class="pillar-num">05</p>
            <h3 class="pillar-title">Strategische Beratung</h3>
            <p class="pillar-body">
              Beratung von Geschäftsführungen quer durch alle
              Unternehmensgrößen zu KI-Chancen, Nordstern-Definition und der
              Lücke zwischen Vision und umsetzbarer Strategie. Ich verstehe
              Geschäft, Prozess und Domäne, nicht nur die Technologie.
            </p>
            <div class="pillar-tags">
              <span class="pillar-tag">Vorstandsberatung</span>
              <span class="pillar-tag">KI-Strategie</span>
              <span class="pillar-tag">Nordstern</span>
              <span class="pillar-tag">Transformation</span>
              <span class="pillar-tag">Keynote-Speaker</span>
            </div>
            <p class="pillar-proof">Berater von Geschäftsführungen · Enterprise &amp; Mittelstand</p>
          </div>

          <div class="pillar">
            <p class="pillar-num">06</p>
            <h3 class="pillar-title">Gründer &amp; Company Building</h3>
            <p class="pillar-body">
              Gründer und Geschäftsführer von Fabricks, mit Smart-Factory-
              Komponenten für Lagerlogistik und Lieferkettendigitalisierung.
              Vom Engineer zum CTO bei SYNDIKAT7 in neun Jahren über mehr
              als ein Dutzend Branchen.
            </p>
            <div class="pillar-tags">
              <span class="pillar-tag">0→1</span>
              <span class="pillar-tag">Smart Factory</span>
              <span class="pillar-tag">Supply Chain</span>
              <span class="pillar-tag">Ventures</span>
              <span class="pillar-tag">Skalierung</span>
            </div>
            <p class="pillar-proof">Gründer &amp; CEO · Fabricks · 9 Jahre SYNDIKAT7</p>
          </div>

          <div class="pillar">
            <p class="pillar-num">07</p>
            <h3 class="pillar-title">Venture Building</h3>
            <p class="pillar-body">
              Ideen von null zum Produkt führen und als eigenständige
              Geschäfte ausgründen. Ich helfe Unternehmen, interne Chancen
              zu erkennen, Konzepte zu validieren, das Produkt zu bauen
              und das Venture für Eigenständigkeit oder Verkauf zu
              strukturieren.
            </p>
            <div class="pillar-tags">
              <span class="pillar-tag">Idee zum Produkt</span>
              <span class="pillar-tag">Ausgründung</span>
              <span class="pillar-tag">Validierung</span>
              <span class="pillar-tag">MVP</span>
              <span class="pillar-tag">Venture-Struktur</span>
            </div>
            <p class="pillar-proof">Ideen in Realität · strukturiert für Eigenständigkeit</p>
          </div>

          <div class="pillar">
            <p class="pillar-num">08</p>
            <h3 class="pillar-title">Keynote Speaking</h3>
            <p class="pillar-body">
              Vorträge auf Konferenzen, in Unternehmen und auf
              Führungs-Offsites zu KI-Strategie und Engineering. Komplexe
              Architekturentscheidungen werden für technische Teams und
              Vorstandsrunden gleichermaßen verständlich.
            </p>
            <div class="pillar-tags">
              <span class="pillar-tag">Keynote</span>
              <span class="pillar-tag">KI-Strategie</span>
              <span class="pillar-tag">Workshops</span>
              <span class="pillar-tag">Corporate Events</span>
            </div>
            <p class="pillar-proof">Speaker · Industry Fellow · 42 Wolfsburg</p>
          </div>

        </div>

        <div
          class="pt-8 mt-4 border-t"
          style="border-color: var(--border);"
        >
          <h2 class="section-label mb-5">Aktueller Fokus</h2>
          <div class="flex flex-wrap gap-6">
            <div class="flex items-center gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full flex-shrink-0" style="background: var(--gold);"></span>
              <span style="font-family: 'Outfit', sans-serif; font-size: 0.875rem; color: var(--text);">ContentNexus</span>
              <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.6rem; letter-spacing: 0.1em; color: var(--text-3);">STEALTH · v0.7</span>
            </div>
            <div class="flex items-center gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full flex-shrink-0" style="background: var(--gold);"></span>
              <span style="font-family: 'Outfit', sans-serif; font-size: 0.875rem; color: var(--text);">Project Ember</span>
              <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.6rem; letter-spacing: 0.1em; color: var(--text-3);">STEALTH</span>
            </div>
            <div class="flex items-center gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full flex-shrink-0" style="background: var(--gold);"></span>
              <span style="font-family: 'Outfit', sans-serif; font-size: 0.875rem; color: var(--text);">Project Meridian</span>
              <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.6rem; letter-spacing: 0.1em; color: var(--text-3);">STEALTH</span>
            </div>
            <div class="flex items-center gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full flex-shrink-0" style="background: var(--gold-light);"></span>
              <span style="font-family: 'Outfit', sans-serif; font-size: 0.875rem; color: var(--text);">Principal Stack</span>
              <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.6rem; letter-spacing: 0.1em; color: var(--text-3);">WÖCHENTLICH</span>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- ── QUOTE ─────────────────────────────────────── -->
    <section
      class="border-t border-b"
      style="border-color: var(--border);"
    >
      <div class="max-w-5xl mx-auto px-6 py-16 text-center">
        <blockquote
          style="font-family: 'Cormorant', Georgia, serif; font-size: clamp(1.3rem, 2.5vw, 1.9rem); font-weight: 300; font-style: italic; line-height: 1.5; color: var(--text-2); max-width: 60ch; margin: 0 auto;"
        >
          "Ever tried. Ever failed. No matter. Try again. Fail again. Fail better."
        </blockquote>
        <p
          class="mt-5"
          style="font-family: 'JetBrains Mono', monospace; font-size: 0.62rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--gold-dim);"
        >
          Samuel Beckett, Worstward Ho (1983)
        </p>
      </div>
    </section>

    <!-- ── PROJECTS ──────────────────────────────────── -->
    <section class="max-w-5xl mx-auto px-6 py-20">
      <h2 class="section-label mb-10">Was gerade entsteht</h2>

      <div
        style="border: 1px solid var(--border-gold); border-radius: 4px; padding: 1.75rem; background: var(--surface);"
      >
        <div class="flex items-center gap-3 mb-4">
          <span
            style="font-family: 'JetBrains Mono', monospace; font-size: 0.58rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--bg); background: var(--gold); padding: 0.2rem 0.6rem; border-radius: 2px;"
          >
            Stealth · v0.7
          </span>
        </div>
        <h3
          style="font-family: 'Cormorant', Georgia, serif; font-size: 1.65rem; font-weight: 500; color: var(--text); margin-bottom: 0.5rem;"
        >
          ContentNexus
        </h3>
        <p
          style="font-size: 0.875rem; color: var(--text-2); line-height: 1.65; margin-bottom: 1rem; max-width: 62ch;"
        >
          Intelligence-Aggregation für Wissensarbeiter. Verfolgt die
          Forschenden, Analysten und Praktiker, die Ihr Feld prägen, und
          erstellt daraus ein Fünf-Minuten-Briefing am Morgen. Sortiert nach
          Signal, nicht nach Lärm. Open Source, selbst gehostet, keine API-Schlüssel.
        </p>
        <span
          style="font-family: 'JetBrains Mono', monospace; font-size: 0.62rem; letter-spacing: 0.1em; color: var(--text-3);"
        >
          Start in Kürze · Details folgen
        </span>
      </div>
    </section>

    <!-- ── WRITING ────────────────────────────────────── -->
    <section class="max-w-5xl mx-auto px-6 py-20">
      <div class="flex items-center justify-between mb-10">
        <h2 class="section-label">Veröffentlichte Beiträge</h2>
        <a
          href="/de/posts"
          style="font-family: 'JetBrains Mono', monospace; font-size: 0.62rem; letter-spacing: 0.1em; color: var(--gold-dim); text-decoration: none;"
          onmouseover="this.style.color='var(--gold-light)'"
          onmouseout="this.style.color='var(--gold-dim)'"
        >Alle Artikel ansehen ↗</a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">

        <a
          href="https://principalstack.substack.com/"
          target="_blank"
          class="writing-card"
        >
          <p class="writing-card-label">Substack · Newsletter</p>
          <h3 class="writing-card-title">Principal Stack</h3>
          <p class="writing-card-desc">
            Wöchentlich für erfahrene Engineers und technische Führungskräfte,
            die KI im Unternehmensmaßstab steuern. Produktionsentscheidungen,
            Architektur-Trade-offs und die Urteilsfragen, die in Lehrbüchern
            nicht stehen.
          </p>
          <p class="mt-4" style="font-family: 'JetBrains Mono', monospace; font-size: 0.65rem; letter-spacing: 0.1em; color: var(--gold-dim);">
            principalstack.substack.com ↗
          </p>
        </a>

        <a
          href="https://medium.com/@pmgiessler"
          target="_blank"
          class="writing-card"
        >
          <p class="writing-card-label">Medium · Artikel</p>
          <h3 class="writing-card-title">Medium</h3>
          <p class="writing-card-desc">
            Lange Artikel zu KI-Engineering, Cloud-Architektur-Mustern und
            Technologieführung für erfahrene Engineers und ihre
            Vorgesetzten.
          </p>
          <p class="mt-4" style="font-family: 'JetBrains Mono', monospace; font-size: 0.65rem; letter-spacing: 0.1em; color: var(--gold-dim);">
            medium.com/@pmgiessler ↗
          </p>
        </a>

      </div>
    </section>

  </main>
</Layout>
