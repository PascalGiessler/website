---
import Layout from "../../../layouts/main.astro";
import ToolDetailBody from "../../../components/tool-detail-body.astro";
import { tools, getTool, toolJsonLd } from "../../../data/tools";

export function getStaticPaths() {
  return tools.map((tool) => ({ params: { slug: tool.slug } }));
}

const { slug } = Astro.params;
const tool = getTool(slug)!;
const c = tool.de;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = toolJsonLd(tool, "de", pageUrl);
---

<Layout
  title={`${tool.name} — ${c.tagline}`}
  description={c.intro}
  keywords={`${tool.name}, ${tool.stack.join(", ")}, Pascal Giessler, Cognitive Debt, souveräne KI, Agentic AI, DACH`}
  jsonLd={jsonLd}
>
  <ToolDetailBody tool={tool} lang="de" />
</Layout>
