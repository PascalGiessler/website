---
import LinkedInPosts from "../../components/linkedin-posts.astro";
import PostsLoop from "../../components/posts-loop.astro";
import Layout from "../../layouts/main.astro";
---

<Layout
  title="Schreiben"
  description="Artikel von Dr. Pascal Giessler zu AI-Transformation, Agentensystemen und technischen Führungsentscheidungen. Mit ausgewählten veröffentlichten LinkedIn-Beiträgen."
  keywords="Pascal Giessler, Essays, Cognitive Debt, souveräne KI, Agentic Engineering, AI-Native Transformation, EU AI Act, DACH"
  image="/assets/images/og/posts.png"
>
  <main class="relative z-10 max-w-3xl mx-auto px-6 pt-28 pb-24 lg:pt-36">

    <div class="mb-12">
      <h1
        class="fade-up delay-2"
        style="font-family: 'Cormorant', Georgia, serif; font-size: clamp(2.4rem, 5vw, 3.8rem); font-weight: 300; line-height: 1.1; letter-spacing: -0.02em; color: var(--text);"
      >
        Artikel &amp; <em style="font-style: italic; color: var(--gold-light);">Essays</em>
      </h1>
      <p class="mt-5 text-base leading-relaxed" style="color: var(--text-2); max-width: 62ch;">Ich schreibe über den Entwurf und Betrieb von Agentensystemen und darüber, welche Entscheidungen Teams und Führungskräfte dabei treffen müssen.</p>
      <a class="inline-block mt-4 text-sm underline underline-offset-4" style="color: var(--gold-light);" href="/posts/">Englische Artikel lesen</a>
    </div>

    <div class="fade-up delay-3">
      <PostsLoop />
    </div>

    <div class="mt-20 pt-12 border-t" style="border-color: var(--border);"><LinkedInPosts /></div>

  </main>
</Layout>
