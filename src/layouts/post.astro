---
import Layout from "./main.astro";
import SubscribeCTA from "../components/subscribe-cta.astro";
import { getLangFromUrl, useTranslations } from "../i18n/ui";
const { frontmatter, prev, next } = Astro.props;
const shellLang = getLangFromUrl(Astro.url);
const t = useTranslations(shellLang);
const postLang = (frontmatter.lang || "en").toUpperCase();
const allWritingHref = shellLang === "de" ? "/de/posts/" : "/posts/";

function isoFromDateFormatted(d) {
  if (!d) return undefined;
  const [month, day, year] = d.split(" ");
  const dt = new Date(`${month} ${parseInt(day)}, ${year}`);
  return isNaN(dt.getTime()) ? undefined : dt.toISOString();
}

const publishedISO = isoFromDateFormatted(frontmatter.dateFormatted);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": frontmatter.title,
  "description": frontmatter.description || frontmatter.title,
  ...(publishedISO ? { "datePublished": publishedISO, "dateModified": publishedISO } : {}),
  "author": {
    "@type": "Person",
    "name": "Dr. Pascal Giessler",
    "url": "https://pascal-giessler.de"
  },
  "publisher": {
    "@type": "Person",
    "name": "Dr. Pascal Giessler",
    "url": "https://pascal-giessler.de"
  },
  "url": Astro.url.href,
  "mainEntityOfPage": Astro.url.href
};
---

<Layout
  title={frontmatter.title}
  description={frontmatter.description}
  ogType="article"
  articlePublishedTime={publishedISO}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(articleSchema)} />

  <main
    class="relative z-30 max-w-3xl mx-auto mt-8 pb-24"
    style="padding-top: 7rem;"
  >
    <!-- Post header -->
    <div
      class="px-6 pb-10 mb-10 border-b lg:px-0"
      style="border-color: var(--border);"
    >
      {frontmatter.dateFormatted && (
        <p
          class="mb-4 flex items-center gap-4"
          style="font-family: 'JetBrains Mono', monospace; font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold-dim);"
        >
          <span class="post-lang-badge">{postLang}</span>
          <span>{frontmatter.dateFormatted}</span>
          {frontmatter.readingTime && (
            <span style="color: var(--text-3);">·&nbsp;{frontmatter.readingTime} {t("post.minRead")}</span>
          )}
        </p>
      )}
      <h1
        style="font-family: 'Cormorant', Georgia, serif; font-size: clamp(2rem, 5vw, 3.2rem); font-weight: 400; line-height: 1.1; letter-spacing: -0.02em; color: var(--text);"
      >
        {frontmatter.title}
      </h1>
      {frontmatter.description && (
        <p
          class="mt-4 text-base leading-relaxed"
          style="color: var(--text-2); max-width: 58ch;"
        >
          {frontmatter.description}
        </p>
      )}
      <p class="mt-3" style="font-size: 0; line-height: 0;">
        <a rel="author" href="https://pascal-giessler.de">Dr. Pascal Giessler</a>
      </p>
    </div>

    <!-- Article body -->
    <article
      class="px-6 lg:px-0 prose prose-invert prose-sm lg:prose-base max-w-none"
      style="
        --tw-prose-body: var(--text-2);
        --tw-prose-headings: var(--text);
        --tw-prose-links: var(--gold-light);
        --tw-prose-bold: var(--text);
        --tw-prose-code: var(--gold-light);
        --tw-prose-pre-bg: var(--surface);
        --tw-prose-quotes: var(--text-2);
        --tw-prose-hr: var(--border);
        --tw-prose-th-borders: var(--border);
        --tw-prose-td-borders: var(--border);
      "
    >
      <slot />
    </article>

    <!-- Subscribe CTA -->
    <div class="px-6 lg:px-0">
      <SubscribeCTA />
    </div>

    <!-- Prev / Next navigation -->
    {(prev || next) && (
      <nav
        class="px-6 lg:px-0 mt-16 pt-10 border-t grid grid-cols-2 gap-6"
        style="border-color: var(--border);"
        aria-label="Article navigation"
      >
        <div>
          {prev && (
            <a
              href={`/post/${prev.slug}/`}
              class="group block"
              style="text-decoration: none;"
            >
              <p style="font-family: 'JetBrains Mono', monospace; font-size: 0.6rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--text-3); margin-bottom: 0.5rem;">{t("post.older")}</p>
              <p
                class="text-sm leading-snug transition-colors duration-200 group-hover:text-[var(--gold-light)]"
                style="color: var(--text-2);"
              >{prev.title}</p>
            </a>
          )}
        </div>
        <div class="text-right">
          {next && (
            <a
              href={`/post/${next.slug}/`}
              class="group block"
              style="text-decoration: none;"
            >
              <p style="font-family: 'JetBrains Mono', monospace; font-size: 0.6rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--text-3); margin-bottom: 0.5rem;">{t("post.newer")}</p>
              <p
                class="text-sm leading-snug transition-colors duration-200 group-hover:text-[var(--gold-light)]"
                style="color: var(--text-2);"
              >{next.title}</p>
            </a>
          )}
        </div>
      </nav>
    )}

    <!-- Back to writing -->
    <div class="px-6 lg:px-0 mt-10">
      <a
        href={allWritingHref}
        style="font-family: 'JetBrains Mono', monospace; font-size: 0.65rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--text-3); text-decoration: none;"
        class="hover:text-[var(--gold-light)] transition-colors duration-200"
      >{t("post.allWriting")}</a>
    </div>
  </main>
</Layout>
