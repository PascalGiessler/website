---
import "../assets/css/main.css";
import "@fontsource/cormorant/300.css";
import "@fontsource/cormorant/400.css";
import "@fontsource/cormorant/500.css";
import "@fontsource/cormorant/300-italic.css";
import "@fontsource/cormorant/400-italic.css";
import "@fontsource/outfit/300.css";
import "@fontsource/outfit/400.css";
import "@fontsource/outfit/500.css";
import "@fontsource/outfit/600.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import Analytics from "../components/analytics.astro";
import Footer from "../components/footer.astro";
import Header from "../components/header.astro";
import { getLangFromUrl, getLocalizedPath, isSingleLanguageRoute, useTranslations } from "../i18n/ui";
import { personSchema } from "../data/entity";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { title, description, keywords, ogType, articlePublishedTime, jsonLd, image } = Astro.props;
const resolvedOgType = ogType || "website";

// Page-specific structured data (SoftwareApplication, FAQPage, DefinedTermSet, …).
// Pass a single object or an array; each becomes its own ld+json script in <head>,
// alongside the global Person schema below.
const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

const metaTitle = title ? (title.includes("Pascal Giessler") ? title : `${title} | Pascal Giessler`) : t("meta.siteTitle");
const metaDescription = description || t("meta.defaultDescription");
const metaKeywords = keywords || "Pascal Giessler, Cognitive Debt, Cognitive Debt Maturity Model, souveräne KI, Sovereign AI, Agentic AI, Agentic Engineering, Agentic Harness, Loop Engineering, Context Engineering, AI-Native Transformation, AI Principal, KI Principal, EU AI Act, GraphRAG, RAG, MCP, KI Strategie, KIT Karlsruhe, Freiburg, DACH, Deutschland";
const canonicalUrl = Astro.url.href;
const siteOrigin = Astro.site ? Astro.site.origin : "https://pascal-giessler.de";
// Essays and atoms exist in one language only, so they get no hreflang pair:
// pointing at a counterpart that does not exist is worse than pointing nowhere.
const singleLanguage = isSingleLanguageRoute(Astro.url.pathname);
const enHref = singleLanguage ? null : new URL(getLocalizedPath(Astro.url.pathname, "en"), siteOrigin).href;
const deHref = singleLanguage ? null : new URL(getLocalizedPath(Astro.url.pathname, "de"), siteOrigin).href;
// Per-page OG card when the page supplies one, else the default identity card.
const ogImage = new URL(image || "/assets/images/og-card.png", siteOrigin).href;

// Search engine verification tokens. Set as build-time env vars
// (PUBLIC_ prefix is required by Astro for client-rendered values).
// Tokens are NOT committed; meta tag only renders when token is present.
const gscToken = import.meta.env.PUBLIC_GSC_VERIFY;
const bingToken = import.meta.env.PUBLIC_BING_VERIFY;

// Canonical machine identity, shared with every other surface (see src/data/entity.ts).
const person = personSchema(lang);
---

<!doctype html>
<html lang={t("lang.htmlAttr")} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{metaTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="keywords" content={metaKeywords} />
    <meta name="author" content="Dr. Pascal Giessler" />
    {gscToken && <meta name="google-site-verification" content={gscToken} />}
    {bingToken && <meta name="msvalidate.01" content={bingToken} />}

    <meta property="og:type" content={resolvedOgType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={t("meta.ogLocale")} />
    <meta property="og:locale:alternate" content={t("meta.ogLocaleAlternate")} />
    <meta property="og:site_name" content="Pascal Giessler" />
    {articlePublishedTime && (
      <>
        <meta property="article:published_time" content={articlePublishedTime} />
        <meta property="article:author" content="https://pascal-giessler.de" />
      </>
    )}

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={metaTitle} />
    <meta property="twitter:description" content={metaDescription} />
    <meta property="twitter:image" content={ogImage} />

    <link rel="canonical" href={canonicalUrl} />
    {enHref && <link rel="alternate" hreflang="en" href={enHref} />}
    {deHref && <link rel="alternate" hreflang="de" href={deHref} />}
    {enHref && <link rel="alternate" hreflang="x-default" href={enHref} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2026-05-10" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2026-05-10" />
    <link rel="alternate" type="application/rss+xml" title="Dr. Pascal Giessler · Writing" href="/rss.xml" />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap-index.xml" />

    <link rel="preload" as="image" href="/assets/images/photo_pascal_branded.png" />

    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}

    <script is:inline>
      if (typeof Storage !== 'undefined') {
        const stored = localStorage.getItem('dark_mode');
        if (stored === 'false') {
          document.documentElement.classList.remove('dark');
        } else {
          document.documentElement.classList.add('dark');
        }
      }
    </script>

    <slot name="head" />
    <Fragment set:html={import.meta.env.HEADER_INJECT} />
  </head>
  <body class="antialiased">
    <Header />
    <slot />
    <Footer />
    <script src="../assets/js/main.js"></script>
    <Analytics />
    <Fragment set:html={import.meta.env.FOOTER_INJECT} />
  </body>
</html>
