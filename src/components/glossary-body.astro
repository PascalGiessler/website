---
// Presentational body for /glossary and /de/glossary.
// Layout props + DefinedTermSet JSON-LD are set by the wrapping page.
import {
  glossaryTerms,
  glossaryCategoryLabels,
  glossaryCategoryOrder,
  termDisplay,
  type GlossaryCategory,
} from "../data/glossary";

interface Props {
  lang: "en" | "de";
}
const { lang } = Astro.props as Props;

const displayBySlug = new Map(glossaryTerms.map((t) => [t.slug, termDisplay(t, lang)]));

const grouped = glossaryCategoryOrder.map((cat) => ({
  cat,
  label: glossaryCategoryLabels[cat as GlossaryCategory][lang],
  terms: glossaryTerms
    .filter((t) => t.category === cat)
    .sort((a, b) => termDisplay(a, lang).localeCompare(termDisplay(b, lang))),
}));

const relatedLabel = lang === "de" ? "Verwandt" : "Related";
const toolsLink = lang === "de" ? "/de/tools/" : "/tools/";
const toolsCta = lang === "de" ? "Die These in Werkzeugen →" : "The thesis, in tools →";
---

<main class="relative z-10 max-w-3xl mx-auto px-6 pt-28 pb-24 lg:pt-36">
  <div class="mb-14">
    <p class="section-label mb-4 fade-up delay-1">{lang === "de" ? "Glossar" : "Glossary"}</p>
    <h1
      class="fade-up delay-2"
      style="font-family: 'Cormorant', Georgia, serif; font-size: clamp(2.4rem, 5vw, 3.8rem); font-weight: 300; line-height: 1.1; letter-spacing: -0.02em; color: var(--text);"
    >
      {lang === "de" ? "Agentic AI, in " : "Agentic AI, in "}<em style="font-style: italic; color: var(--gold-light);">{lang === "de" ? "Klartext" : "plain terms"}</em>
    </h1>
    <p class="fade-up delay-3 mt-5" style="color: var(--text-2); font-size: 1.05rem; line-height: 1.7; max-width: 44rem;">
      {lang === "de"
        ? "Das Vokabular agentischer KI, dryly definiert: Harness, Agenten, Tool Use, Retrieval und die Souveränitätsbegriffe, die darüber entscheiden, wem das System am Ende gehört. Kein Hype, keine Em-Dashes."
        : "The vocabulary of agentic AI, defined dryly: harness, agents, tool use, retrieval, and the sovereignty terms that decide who ends up owning the system. No hype, no em-dashes."}
    </p>
  </div>

  {grouped.map((group) => (
    <section class="fade-up delay-3 mb-14">
      <h2 class="section-label mb-6" style="color: var(--gold-dim);">{group.label}</h2>
      <dl class="grid grid-cols-1 gap-9">
        {group.terms.map((t) => (
          <div id={t.slug} style="scroll-margin-top: 6rem;">
            <dt
              style="font-family: 'Cormorant', Georgia, serif; font-size: 1.6rem; font-weight: 500; color: var(--text); line-height: 1.15;"
            >
              {termDisplay(t, lang)}
            </dt>
            <dd class="mt-2" style="margin-inline-start: 0; color: var(--text-2); font-size: 1.02rem; line-height: 1.65;">
              {t[lang]}
              {t.related.length > 0 && (
                <p class="mt-3" style="font-family: 'JetBrains Mono', monospace; font-size: 0.62rem; letter-spacing: 0.08em; color: var(--text-3);">
                  {relatedLabel}:{" "}
                  {t.related.map((slug, i) => (
                    <>
                      {i > 0 && <span style="color: var(--text-3);"> · </span>}
                      <a href={`#${slug}`} style="color: var(--gold-dim); text-decoration: none;">{displayBySlug.get(slug) ?? slug}</a>
                    </>
                  ))}
                </p>
              )}
            </dd>
          </div>
        ))}
      </dl>
    </section>
  ))}

  <div class="fade-up delay-3 pt-6" style="border-top: 1px solid var(--border);">
    <a href={toolsLink} style="font-family: 'JetBrains Mono', monospace; font-size: 0.72rem; letter-spacing: 0.08em; color: var(--gold-dim); text-decoration: none;">
      {toolsCta}
    </a>
  </div>
</main>
