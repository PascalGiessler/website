---
import { sortedPosts, formatPostDate, postDate } from "../lib/posts.mjs";
import { getLangFromUrl, useTranslations } from "../i18n/ui";
import { getCollection } from "astro:content";
const postDateISO = (value: string) => postDate(value).toISOString().slice(0, 10);
const allPosts = await getCollection("post");
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
interface Props { count?: number; heading?: "h2" | "h3"; }
const { count, heading: Heading = "h2" } = Astro.props;
const posts = sortedPosts(allPosts, { lang });
const postsLoop = (count ? posts.slice(0, count) : posts).map((post) => ({
  ...post.data,
  readingTime: Math.max(1, Math.round((post.body ?? "").split(/\s+/).filter(Boolean).length / 200)),
  link: post._path,
  lang: post.data.lang || "en",
}));
---

{postsLoop.map((post) => (
  <a
    href={post.link}
    class="group block"
    style="text-decoration: none;"
  >
    <div
      class="py-5 border-b transition-colors duration-200"
      style="border-color: var(--border);"
    >
      <div class="flex items-start justify-between gap-4">
        <div>
          <Heading
            class="mb-1.5 text-base font-medium leading-snug transition-colors duration-200"
            style="color: var(--text); font-family: 'Outfit', system-ui, sans-serif;"
          >
            {post.title}
          </Heading>
          <p
            class="text-[0.95rem] leading-relaxed"
            style="color: var(--text-2); max-width: 60ch;"
          >
            {post.description}
          </p>
        </div>
        <span
          class="flex-shrink-0 mt-1 text-lg transition-transform duration-200 ease-out group-hover:translate-x-1"
          style="color: var(--gold-dim);"
        >
          →
        </span>
      </div>
      <p
        class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1"
        style="font-size: 0.8rem; color: var(--text-3); font-variant-numeric: tabular-nums;"
      >
        <span class="post-lang-badge">{post.lang.toUpperCase()}</span>
        <time datetime={postDateISO(post.dateFormatted)}>{formatPostDate(post.dateFormatted, lang)}</time>
        <span style="color: var(--border-gold);">·</span>
        <span>{post.readingTime}{" "}{t("post.minRead")}</span>
      </p>
    </div>
  </a>
))}