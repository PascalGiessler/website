---
import { postPath } from "../lib/posts.mjs";
import { getCollection } from "astro:content";
const allPosts = await getCollection("post");

const { count } = Astro.props;

function parseDate(dateStr: string) {
  const [month, day, year] = dateStr.split(" ");
  return new Date(`${month} ${parseInt(day)}, ${year}`);
}

function readingMinutes(body: string | undefined) {
  const words = (body ?? "").split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.round(words / 200));
}

const sortedPosts = allPosts
  .map((post) => ({
    ...post,
    date: parseDate(post.data.dateFormatted),
  }))
  .sort((a, b) => b.date.getTime() - a.date.getTime());

const postsLoop = (count ? sortedPosts.slice(0, count) : sortedPosts).map((post) => ({
  ...(post.data || {}),
  readingTime: readingMinutes(post.body),
  link: postPath(post),
  lang: post.data.lang || 'en',
}));
---

{postsLoop.map((post) => (
  <a
    href={post.link}
    class="group block"
    style="text-decoration: none;"
  >
    <div
      class="py-5 border-b transition-colors duration-200"
      style="border-color: var(--border);"
    >
      <div class="flex items-start justify-between gap-4">
        <div>
          <h2
            class="mb-1.5 text-base font-medium leading-snug transition-colors duration-200"
            style="color: var(--text); font-family: 'Outfit', system-ui, sans-serif;"
          >
            {post.title}
          </h2>
          <p
            class="text-sm leading-relaxed"
            style="color: var(--text-3); max-width: 60ch;"
          >
            {post.description}
          </p>
        </div>
        <span
          class="flex-shrink-0 mt-1 text-lg transition-transform duration-200 ease-out group-hover:translate-x-1"
          style="color: var(--gold-dim);"
        >
          →
        </span>
      </div>
      <p
        class="mt-3 flex items-center gap-3"
        style="font-family: 'JetBrains Mono', monospace; font-size: 0.62rem; letter-spacing: 0.12em; color: var(--text-3);"
      >
        <span class="post-lang-badge">{post.lang.toUpperCase()}</span>
        <span>{post.dateFormatted}</span>
        <span style="color: var(--border-gold);">·</span>
        <span>{post.readingTime} min read</span>
      </p>
    </div>
  </a>
))}