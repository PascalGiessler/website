---
import { linkedinPosts } from "../data/linkedin";
import { getLangFromUrl } from "../i18n/ui";
import { formatPostDate, postDate } from "../lib/posts.mjs";
const lang = getLangFromUrl(Astro.url);
const de = lang === "de";
const posts = linkedinPosts.filter((post) => postDate(post.published) <= new Date());
---

<section class="linkedin-posts" aria-labelledby="linkedin-heading">
  <div class="mb-7">
    <h2 id="linkedin-heading" style="font-family: 'Cormorant', Georgia, serif; font-size: clamp(1.9rem, 4vw, 2.8rem); font-weight: 300; line-height: 1.12; color: var(--text);">
      {de ? "Auf LinkedIn" : "On LinkedIn"}
    </h2>
    <p class="mt-3 text-sm leading-relaxed" style="color: var(--text-2); max-width: 62ch;">
      {de ? "Kurze Beiträge zu Entscheidungen beim Bau und Betrieb von Agentensystemen. Die Diskussion findet beim Originalbeitrag statt." : "Short posts on decisions in building and running agent systems. Follow the links to join the original discussions in German."}
    </p>
  </div>
  <ul class="list-none p-0 m-0">
    {posts.map((post) => (
      <li style="border-top: 1px solid var(--border);">
        <a class="linkedin-post" href={post.url}>
          <time datetime={post.published}>{formatPostDate(post.published, lang)}</time>
          <div>
            <h3>{post[lang].title}</h3>
            <p>{post[lang].summary}</p>
            <span class="linkedin-post__cta">{de ? "Beitrag auf LinkedIn lesen" : "Read on LinkedIn · German"}<span aria-hidden="true"> ↗</span></span>
          </div>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .linkedin-post { display: grid; grid-template-columns: 8rem minmax(0, 1fr); gap: 1.5rem; padding: 1.6rem 0; text-decoration: none; }
  .linkedin-post time { font-size: .8rem; color: var(--text-3); font-variant-numeric: tabular-nums; padding-top: .2rem; }
  .linkedin-post h3 { font-size: 1.05rem; font-weight: 500; color: var(--text); line-height: 1.45; }
  .linkedin-post p { color: var(--text-2); font-size: .95rem; line-height: 1.65; margin-top: .5rem; max-width: 65ch; }
  .linkedin-post__cta { display: inline-block; color: var(--gold-light); font-size: .85rem; margin-top: .75rem; text-decoration: underline; text-underline-offset: .25em; text-decoration-color: transparent; transition: text-decoration-color .2s; }
  .linkedin-post:hover .linkedin-post__cta { text-decoration-color: currentColor; }
  .linkedin-post:focus-visible { outline: 2px solid var(--gold-light); outline-offset: 5px; border-radius: 2px; }
  @media (max-width: 640px) { .linkedin-post { grid-template-columns: 1fr; gap: .5rem; } }
</style>
