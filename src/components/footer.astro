---
import { getLangFromUrl, useTranslations } from "../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const impressumHref = lang === "de" ? "/de/impressum" : "/impressum";
---

<footer
  class="relative z-10 mt-24 border-t"
  style="border-color: var(--border); background: var(--bg);"
>
  <div class="max-w-5xl mx-auto px-6 py-10 flex flex-col sm:flex-row items-center justify-between gap-6">

    <div class="flex items-center gap-3">
      <span style="font-family: 'Cormorant', Georgia, serif; font-size: 1rem; font-weight: 400; color: var(--text-2); letter-spacing: 0.02em;">
        Dr. Pascal Giessler
      </span>
      <span style="color: var(--border-gold);">·</span>
      <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.65rem; letter-spacing: 0.15em; color: var(--text-3);">
        © {new Date().getFullYear()}
      </span>
    </div>

    <div class="flex items-center gap-5">

      <a
        href="https://www.linkedin.com/in/pgiessler/"
        target="_blank"
        aria-label="LinkedIn"
        class="transition-colors duration-200"
        style="color: var(--text-3);"
        onmouseover="this.style.color='var(--gold)'"
        onmouseout="this.style.color='var(--text-3)'"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </a>

      <a
        href="https://principalstack.substack.com/"
        target="_blank"
        aria-label="Substack"
        class="transition-colors duration-200"
        style="color: var(--text-3);"
        onmouseover="this.style.color='var(--gold)'"
        onmouseout="this.style.color='var(--text-3)'"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"/>
        </svg>
      </a>

      <span style="color: var(--border);">·</span>

      <a
        href={impressumHref}
        style="font-family: 'JetBrains Mono', monospace; font-size: 0.6rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-3); text-decoration: none; transition: color 0.2s ease-out;"
        onmouseover="this.style.color='var(--text-2)'"
        onmouseout="this.style.color='var(--text-3)'"
      >
        {t("footer.impressum")}
      </a>
    </div>

  </div>
</footer>
