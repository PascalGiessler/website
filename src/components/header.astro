---
import menus from "../collections/menu.json";
import Logo from "./logo.astro";
import LanguageSwitcher from "./language-switcher.astro";
import { getLangFromUrl, useTranslations, type UIKey } from "../i18n/ui";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const primary = new Set(["about", "writing", "tools", "publications"]);
const path = Astro.url.pathname;
function current(menu: { key: string; url: string }): "page" | "location" | undefined {
  if (path === menu.url) return "page";
  if (path.startsWith(menu.url) || (menu.key === "writing" && path.startsWith(lang === "de" ? "/de/post/" : "/post/"))) return "location";
  return undefined;
}
---
<div class="site-header-spacer" aria-hidden="true"></div>
<header id="header" class="site-header">
  <div class="site-header__inner page-width">
    <Logo />
    <div id="mobileMenuBackground" class="menu-backdrop" hidden aria-hidden="true"></div>
    <div class="site-header__controls">
      <LanguageSwitcher />
      <button id="menuToggle" class="menu-toggle" type="button" aria-label={lang === "de" ? "Navigation öffnen" : "Open navigation menu"} data-open-label={lang === "de" ? "Navigation öffnen" : "Open navigation menu"} data-close-label={lang === "de" ? "Navigation schließen" : "Close navigation menu"} aria-expanded="false" aria-controls="menu">
        <span>{lang === "de" ? "Menü" : "Menu"}</span>
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path class="menu-open-icon" d="M4 8h16M4 16h16"/><path class="menu-close-icon" d="m6 6 12 12M6 18 18 6"/></svg>
      </button>
      <nav id="menu" aria-label={lang === "de" ? "Hauptnavigation" : "Main navigation"}>
        {menus[lang].map(menu => <a href={menu.url} class:list={["site-nav-link", {"site-nav-link--secondary": !primary.has(menu.key)}]} aria-current={current(menu)}>{t(`nav.${menu.key}` as UIKey)}</a>)}
      </nav>
    </div>
  </div>
</header>
<style>
  .site-header-spacer { height: 5rem; }
  .site-header { position: fixed; inset: 0 0 auto; height: 5rem; z-index: 50; background: var(--bg); border-bottom: 1px solid var(--border); }
  .site-header__inner { display: flex; align-items: center; justify-content: space-between; gap: 1rem; height: 100%; }
  .site-header__controls { display: flex; align-items: center; gap: 1.5rem; }
  #menu { display: flex; align-items: center; gap: 1.6rem; }
  .site-nav-link { display: inline-flex; align-items: center; min-height: 44px; color: var(--text-2); font-size: .9rem; text-decoration: none; text-underline-offset: .5em; text-decoration-thickness: 1px; transition: color .2s; }
  .site-nav-link:hover { color: var(--text); text-decoration: underline; }
  .site-nav-link[aria-current] { color: var(--gold-light); text-decoration: underline; }
  .site-nav-link--secondary { display: none; }
  .menu-toggle { display: none; }
  .menu-backdrop { position: fixed; inset: 5rem 0 0; background: oklch(.1 .008 58 / .8); z-index: -1; }
  @media (max-width: 480px) { .menu-toggle > span { display: none; } .site-header__inner { gap: .5rem; } }
  @media (max-width: 1023px) {
    .site-header__controls { gap: .5rem; }
    .menu-toggle { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; min-width: 44px; min-height: 44px; background: none; border: 0; color: var(--text); cursor: pointer; font-size: .9rem; }
    .menu-toggle svg { width: 24px; height: 24px; }
    .menu-close-icon { display: none; }
    .menu-toggle[aria-expanded="true"] .menu-close-icon { display: block; }
    .menu-toggle[aria-expanded="true"] .menu-open-icon { display: none; }
    #menu { display: none; position: fixed; top: 5rem; left: 0; right: 0; padding: 1rem 1.5rem 1.5rem; border-bottom: 1px solid var(--border-gold); background: var(--bg); max-height: calc(100dvh - 5rem); overflow-y: auto; }
    #menu.is-open { display: flex; flex-direction: column; align-items: stretch; gap: 0; }
    .site-nav-link, .site-nav-link--secondary { display: flex; min-height: 52px; border-bottom: 1px solid var(--border); font-size: 1.1rem; }
  }
</style>
