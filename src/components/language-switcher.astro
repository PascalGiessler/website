---
import { getLangFromUrl, getLocalizedPath, isSingleLanguageRoute, type Lang } from "../i18n/ui";

const currentLang = getLangFromUrl(Astro.url);
const otherLang: Lang = currentLang === "en" ? "de" : "en";

// Essays and atoms exist in one language only. Switching language from such a
// page has no counterpart to go to, so send the reader to that language's
// writing index rather than to a 404.
const alternatePath = isSingleLanguageRoute(Astro.url.pathname)
  ? (otherLang === "de" ? "/de/posts/" : "/posts/")
  : getLocalizedPath(Astro.url.pathname, otherLang);

const otherLabel = otherLang.toUpperCase();
const currentLabel = currentLang.toUpperCase();
---

<div class="lang-switcher" aria-label={currentLang === "de" ? "Sprache" : "Language"}>
  <span class="lang-current" aria-current="true">{currentLabel}</span>
  <span class="lang-divider" aria-hidden="true">/</span>
  <a href={alternatePath} class="lang-other" hreflang={otherLang} aria-label={currentLang === "de" ? "Zu Englisch wechseln" : "Switch to German"}>
    {otherLabel}
  </a>
</div>

<style>
  .lang-switcher {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-left: 0;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }
  .lang-current {
    color: var(--gold-light);
  }
  .lang-divider {
    color: var(--border-gold);
  }
  .lang-other {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    color: var(--text-3);
    text-decoration: none;
    transition: color 0.2s ease-out;
  }
  .lang-other:hover {
    color: var(--gold-light);
  }
  @media (max-width: 480px) { .lang-current, .lang-divider { display: none; } .lang-switcher { gap: 0; } }
</style>
