---
---

<a
  href="/"
  class="relative z-30 flex items-center gap-3 group"
  style="text-decoration: none;"
>
  <!-- Brand mark: P|G typographic monogram with gold axis-line.
       Family-resemblance with Stack und Haltung (S|H) and Principal Stack (P|S). -->
  <svg
    width="28"
    height="28"
    viewBox="0 0 32 32"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="logo-mark transition-transform duration-300 ease-out group-hover:scale-110"
    aria-hidden="true"
  >
    <line
      class="logo-axis"
      x1="16" y1="5" x2="16" y2="27"
      stroke-width="2"
      stroke-linecap="round"
    />
    <text
      class="logo-letter"
      x="8" y="22"
      font-family="Cormorant, Georgia, serif"
      font-size="18"
      font-weight="500"
      text-anchor="middle"
    >P</text>
    <text
      class="logo-letter"
      x="25" y="22"
      font-family="Cormorant, Georgia, serif"
      font-size="18"
      font-weight="500"
      text-anchor="middle"
    >G</text>
  </svg>
  <span
    style="font-family: 'Cormorant', Georgia, serif; font-size: 1.05rem; font-weight: 400; letter-spacing: 0.03em; color: var(--text); white-space: nowrap;"
  >
    Dr. Pascal Giessler
  </span>
</a>

<style>
  .logo-axis { stroke: var(--gold); }
  .logo-letter { fill: var(--text); }
</style>
